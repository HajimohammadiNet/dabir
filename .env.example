APP_NAME=dabir
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8080

API_PORT=8080
WEB_PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_USER=dabir
DB_PASSWORD=change-this-db-password
DB_NAME=dabir
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10

JWT_SECRET=change-this-secret-in-production
JWT_ACCESS_TOKEN_TTL_MINUTES=60

CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOWED_METHODS=GET,POST,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Accept,Authorization,Content-Type,X-CSRF-Token,X-Request-ID

NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=dabir-attachments
S3_ACCESS_KEY=dabir
S3_SECRET_KEY=dabir_minio_secret
S3_USE_SSL=false
S3_FORCE_PATH_STYLE=true
S3_PRESIGNED_URL_TTL_MINUTES=15
S3_MAX_UPLOAD_SIZE_MB=20

MINIO_ROOT_USER=dabir
MINIO_ROOT_PASSWORD=dabir_minio_secret
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
